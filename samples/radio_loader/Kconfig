source "Kconfig.zephyr"

choice RADIO_LOADER_MODE
	prompt "Radio loader mode"
	default RADIO_LOADER_MODE_COPY

config RADIO_LOADER_MODE_COPY
	bool "Copy mode - copy the firmware to the TCM from the radio loader"

config RADIO_LOADER_MODE_MPC
	bool "MPC mode - let app core image copy the firmware to the TCM, just configure the MPC and jump"

endchoice
