 / {
	chosen {
		zephyr,code-partition = &app_code_partition;
	};

	timestamps {
		compatible = "gpio-leds";
		timestamp0: timestamp_0 {
			gpios = < &gpio1 15 GPIO_ACTIVE_HIGH >;
			label = "Timestamp 0 GPIO - app";
		};

		timestamp1: timestamp_1 {
			gpios = < &gpio1 16 GPIO_ACTIVE_HIGH >;
			label = "Timestamp 1 GPIO - app";
		};

		timestamp2: timestamp_2 {
			gpios = < &gpio1 17 GPIO_ACTIVE_HIGH >;
			label = "Timestamp 2 GPIO - radio events";
		};

		timestamp3: timestamp_3 {
			gpios = < &gpio1 18 GPIO_ACTIVE_HIGH >;
			label = "Timestamp 3 GPIO - radio events";
		};
	};

	aliases {
		timestamp0 = &timestamp0;
		timestamp1 = &timestamp1;
		timestamp2 = &timestamp2;
		timestamp3 = &timestamp3;
	};
};

&cpuapp_rram {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		app_code_partition: partition@0 {
			label = "code";
			reg = <0x0 DT_SIZE_K(852)>;
		};

		raw_flash_partition: partition@d5000 {
			label = "raw_flash";
			reg = <0xd5000 DT_SIZE_K(80)>;
		};
	};
};
