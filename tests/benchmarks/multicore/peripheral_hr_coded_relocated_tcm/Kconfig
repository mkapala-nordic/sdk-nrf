source "Kconfig.zephyr"

choice RADIO_LOADER_MODE
	prompt "Radio loader mode"
	default RADIO_LOADER_MODE_COPY

config RADIO_LOADER_MODE_COPY
	bool "Copy mode - don't do anything in app core image"

config RADIO_LOADER_MODE_MPC
	bool "MPC mode - copy firmware to TCM from app core while radio loader configures access and jumps to it"

endchoice
